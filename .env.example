APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_HOSTS=app.uhlms.uk,localhost,127.0.0.1,::1
PUBLIC_HTTPS_ENFORCED=false
PUBLIC_HTTPS_HOST=app.uhlms.uk
HSTS_MAX_AGE=2592000
CONTENT_SECURITY_POLICY_MODE=report-only
ADMIN_MFA_MODE=optional
MFA_REQUIRED_ROLES=super_admin,admin
MFA_PENDING_TTL_SECONDS=600
MFA_RECENT_SECONDS=600
BACKUP_ENCRYPTION_KEY=
BACKUP_ROUTINE_KEEP=10
BACKUP_ROUTINE_DAYS=30
BACKUP_PRE_RESTORE_KEEP=3
BACKUP_PRE_RESTORE_DAYS=7
SECURITY_MONITOR_ENABLED=true
SECURITY_RESPONSE_THRESHOLD=10
SECURITY_RESPONSE_WINDOW_SECONDS=300
SECURITY_WEBHOOK_THRESHOLD=5
SECURITY_WEBHOOK_WINDOW_SECONDS=300
SECURITY_ADMIN_AUTH_THRESHOLD=5
SECURITY_ADMIN_AUTH_WINDOW_SECONDS=600
SECURITY_ALERT_COOLDOWN_SECONDS=1800
SECURITY_ALERT_HOURLY_CAP=20
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=brevo
MAIL_SCHEME=tls
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_MAIL_HOST=smtp-relay.brevo.com
BREVO_MAIL_PORT=587
BREVO_MAIL_SCHEME=tls
BREVO_MAIL_USERNAME=
BREVO_MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo Online Payment Gateway (TESTING - Reversible)
# Get your API keys from: https://dashboard.paymongo.com/developers
# Use test keys (sk_test_*, pk_test_*) for development
# Use live keys (sk_live_*, pk_live_*) only in production
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_EXPIRY_HOURS=24
PAYMONGO_STRICT_WEBHOOK_VERIFICATION=true
PAYMONGO_CA_BUNDLE=
PAYMONGO_ALLOW_INSECURE_TLS=false
